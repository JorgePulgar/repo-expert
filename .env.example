# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Azure OpenAI ---
# Azure AI Foundry resources serve this host form; classic Azure OpenAI resources
# use https://<resource>.openai.azure.com/ instead. Both work with the same client.
AZURE_OPENAI_ENDPOINT=https://<resource>.services.ai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Cheap chat model for generation/routing/grounding (the only paid LLM after the
# Qdrant migration; embeddings are free via Qdrant Cloud Inference).
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-mini
# Embeddings now run server-side in Qdrant; this Azure embed deployment is unused
# (kept only for the legacy Azure-Search path). Safe to leave blank on the Qdrant stack.
AZURE_OPENAI_EMBED_DEPLOYMENT=

# --- Azure AI Search (legacy; REQUIRED but unused on the Qdrant stack) ---
# Retrieval moved to Qdrant in Phase 7, but Settings still declares these as required
# fields, so startup fails with a validation error if they are empty. Any non-empty
# placeholder works when you are on Qdrant.
AZURE_SEARCH_ENDPOINT=https://<service>.search.windows.net
AZURE_SEARCH_API_KEY=placeholder
# Index names are derived from the active instance config; override here if needed.

# --- GitHub (source 3 for public-repo instance: issues/PRs) ---
GITHUB_TOKEN=

# --- App ---
# Which instance config to load: "public" (FastAPI) or "portfolio".
REPO_EXPERT_INSTANCE=public
# Comma-separated frontend origins allowed to call the API (CORS). "*" = any origin.
# Production is scoped to the site that hosts the chat page (P8-T5); include a local
# dev-server origin while building the page. A rejected origin gets HTTP 400.
CORS_ORIGINS=https://jorgepulgar.com,https://www.jorgepulgar.com,http://localhost:5500
# Per-IP hourly budget for /ask. It is unauthenticated and every call costs money,
# and CORS only constrains browsers - a script can call the endpoint directly.
# /health is never limited (the chat page pings it to warm the container).
# 0 disables the limiter, for local development only.
RATE_LIMIT_PER_HOUR=10

# --- Qdrant (retrieval backend; replaces Azure AI Search after the P7 migration) ---
QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io:6333
QDRANT_API_KEY=
# Embedding model via Qdrant Cloud free inference (server-side, cloud_inference=True).
# mxbai-embed-large-v1 is NOT allowed on the free tier; MiniLM (384-dim) is the fallback.
QDRANT_EMBED_MODEL=intfloat/multilingual-e5-small
