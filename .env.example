# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-large

# --- Azure AI Search ---
AZURE_SEARCH_ENDPOINT=https://<service>.search.windows.net
AZURE_SEARCH_API_KEY=
# Index names are derived from the active instance config; override here if needed.

# --- GitHub (source 3 for public-repo instance: issues/PRs) ---
GITHUB_TOKEN=

# --- App ---
# Which instance config to load: "public" (FastAPI) or "portfolio".
REPO_EXPERT_INSTANCE=public

# --- Qdrant (retrieval backend; replaces Azure AI Search after the P7 migration) ---
QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io:6333
QDRANT_API_KEY=
# Embedding model via Qdrant Cloud free inference (server-side, cloud_inference=True).
# mxbai-embed-large-v1 is NOT allowed on the free tier; MiniLM (384-dim) is the fallback.
QDRANT_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
