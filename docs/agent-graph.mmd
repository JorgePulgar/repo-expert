---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	router(router)
	retrieve(retrieve)
	generate(generate)
	grounding(grounding)
	fallback(fallback)
	__end__([<p>__end__</p>]):::last
	__start__ --> router;
	fallback --> retrieve;
	generate --> grounding;
	grounding -. &nbsp;end&nbsp; .-> __end__;
	grounding -. &nbsp;revise&nbsp; .-> fallback;
	retrieve --> generate;
	router --> retrieve;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
